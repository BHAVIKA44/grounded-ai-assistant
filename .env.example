# Application
APP_NAME=Grounded AI Assistant
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Vector Store
CHROMA_PERSIST_DIR=./data/chroma

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# LLM - OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# LLM - Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Reranking
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=5

# Retrieval
BM25_TOP_K=10
VECTOR_TOP_K=10
HYBRID_TOP_K=10

# Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=grounded-ai-assistant
LANGSMITH_TRACING=true

# Fine-tuning
FINE_TUNE_MODEL_BASE=meta-llama/Llama-2-7b-hf
FINE_TUNE_OUTPUT_DIR=./models/lora
FINE_TUNE_RANK=8
FINE_TUNE_ALPHA=16
FINE_TUNE_DROPOUT=0.05

# Security
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,txt,docx
RATE_LIMIT_PER_MINUTE=60